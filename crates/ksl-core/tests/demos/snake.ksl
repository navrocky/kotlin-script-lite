// Terminal snake, playable via `cargo run -p ksl-cli -- crates/ksl-core/tests/demos/snake.ksl`
// in a real terminal (see this directory's README.md — this is a manual
// demo, not a golden-output `cargo test` fixture).
//
// Exercises every capability Phase 6.6 added: List.get/set/add/size/
// removeAt (the snake's own body), kotlin.random (food placement),
// ksl.term's raw-mode readByte (WASD controls, no Enter needed) and
// terminalWidth/terminalHeight (sizes the board to the real terminal),
// sleep (frame pacing), and tui.ksl (screen/cursor control, itself built
// on nothing but ksl.term + the \u{XXXX} string escape — see that file).
//
// Controls: w/a/s/d to steer, q to quit.

@file:Import("tui.ksl")

import kotlin.random.*
import ksl.term.*

class Point(val x: Int, val y: Int)

fun main() {
    if (!isTerminal()) {
        println("snake.ksl needs a real terminal to play — run it directly, not piped.")
        return
    }

    // Sized to the real terminal, but always clamped to a sane range —
    // some terminals (or a pty with no window size ever explicitly set)
    // report 0x0, and randomInt() below needs a genuinely positive bound
    // either way.
    var width = terminalWidth() - 2
    if (width < 20) {
        width = 20
    }
    if (width > 60) {
        width = 60
    }
    var height = terminalHeight() - 4
    if (height < 10) {
        height = 10
    }
    if (height > 30) {
        height = 30
    }

    var snake = listOf(Point(width / 2, height / 2))
    var dirX = 1
    var dirY = 0
    var food = Point(randomInt(width), randomInt(height))
    var alive = true

    enableRawMode()
    hideCursor()
    clearScreen()

    while (alive) {
        val key = readByte()
        if (key != null) {
            val k = key
            if (k == 113) {
                alive = false
            } else if (k == 97 && dirX != 1) {
                dirX = -1
                dirY = 0
            } else if (k == 100 && dirX != -1) {
                dirX = 1
                dirY = 0
            } else if (k == 119 && dirY != 1) {
                dirX = 0
                dirY = -1
            } else if (k == 115 && dirY != -1) {
                dirX = 0
                dirY = 1
            }
        }

        if (alive) {
            val head: Point = snake.get(snake.size() - 1)
            val newHead = Point(head.x + dirX, head.y + dirY)

            if (newHead.x < 0 || newHead.x >= width || newHead.y < 0 || newHead.y >= height) {
                alive = false
            } else {
                var hitSelf = false
                var i = 0
                while (i < snake.size()) {
                    val seg: Point = snake.get(i)
                    if (seg.x == newHead.x && seg.y == newHead.y) {
                        hitSelf = true
                    }
                    i = i + 1
                }

                if (hitSelf) {
                    alive = false
                } else {
                    snake.add(newHead)
                    if (newHead.x == food.x && newHead.y == food.y) {
                        food = Point(randomInt(width), randomInt(height))
                    } else {
                        snake.removeAt(0)
                    }

                    moveCursor(1, 1)
                    var row = 0
                    while (row < height) {
                        var line = ""
                        var col = 0
                        while (col < width) {
                            var ch = "."
                            if (food.x == col && food.y == row) {
                                ch = "*"
                            }
                            var j = 0
                            while (j < snake.size()) {
                                val s: Point = snake.get(j)
                                if (s.x == col && s.y == row) {
                                    ch = "#"
                                }
                                j = j + 1
                            }
                            line = line + ch
                            col = col + 1
                        }
                        println(line)
                        row = row + 1
                    }
                    println("score: " + (snake.size() - 1) + "   (w/a/s/d to steer, q to quit)")
                }
            }
        }

        sleep(120)
    }

    disableRawMode()
    showCursor()
    clearScreen()
    moveCursor(1, 1)
    println("Game over! Score: " + (snake.size() - 1))
}

main()
