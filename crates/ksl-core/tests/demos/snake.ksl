// Terminal snake, playable via `cargo run -p ksl-cli -- crates/ksl-core/tests/demos/snake.ksl`
// in a real terminal (see this directory's README.md — this is a manual
// demo, not a golden-output `cargo test` fixture).
//
// Exercises every capability Phase 6.6 added: List.get/set/add/size/
// removeAt (the snake's own body), kotlin.random (food placement),
// ksl.term's raw-mode readByte (WASD/arrow controls, no Enter needed) and
// terminalWidth/terminalHeight (sizes the board to the real terminal),
// sleep (frame pacing), and tui.ksl (screen/cursor/color control, itself
// built on nothing but ksl.term + the \u{XXXX} string escape — see that
// file; color control specifically lives there, not here, per the same
// "only what genuinely needs a syscall is native" principle).
//
// Controls: w/a/s/d or arrow keys to steer, q to quit.
// Legend: @ bright yellow snake, O bold bright red food, % white fence,
// . green grass.

@file:Import("tui.ksl")

import kotlin.random.*
import ksl.term.*

// Raw byte values readByte() returns for WASD + quit, and the canonical
// direction codes arrow keys get mapped onto below.
val KEY_LEFT = 97 // 'a'
val KEY_RIGHT = 100 // 'd'
val KEY_UP = 119 // 'w'
val KEY_DOWN = 115 // 's'
val KEY_QUIT = 113 // 'q'

// Arrow keys arrive as a 3-byte escape sequence: ESC '[' <letter>. Read
// as WASD's equivalent byte once recognized, so the rest of the input
// handling doesn't need to know arrows exist.
val KEY_ESCAPE = 27
val ARROW_PREFIX = 91 // '['
val ARROW_UP_BYTE = 65 // 'A'
val ARROW_DOWN_BYTE = 66 // 'B'
val ARROW_RIGHT_BYTE = 67 // 'C'
val ARROW_LEFT_BYTE = 68 // 'D'

val FENCE_CHAR = "%"
val GRASS_CHAR = "."
val SNAKE_CHAR = "@"
val FOOD_CHAR = "O"

// Apples appear one at a time at a random interval, up to this many on
// the board at once.
val MAX_FOOD = 5
val FOOD_SPAWN_MIN_TICKS = 20 // ~2.4s at the 120ms tick rate below
val FOOD_SPAWN_MAX_TICKS = 50 // ~6s
val FOOD_PLACEMENT_ATTEMPTS = 10 // give up on this spawn if the board's this crowded

// What's occupying a cell, tracked per cell while rendering a row so a
// style escape is only emitted when it actually changes from the
// previous cell.
val KIND_NONE = -1
val KIND_GRASS = 0
val KIND_SNAKE = 1
val KIND_FOOD = 2

class Point(val x: Int, val y: Int)

fun getRandomPoint(width: Int, height: Int) = Point(randomInt(width), randomInt(height))

fun main() {
    if (!isTerminal()) {
        println("snake.ksl needs a real terminal to play — run it directly, not piped.")
        return
    }

    // Sized to the real terminal, but always clamped to a sane range —
    // some terminals (or a pty with no window size ever explicitly set)
    // report 0x0, and randomInt() below needs a genuinely positive bound
    // either way.
    var width = terminalWidth() - 2
    if (width < 20) {
        width = 20
    }
    if (width > 60) {
        width = 60
    }
    var height = terminalHeight() - 4
    if (height < 10) {
        height = 10
    }
    if (height > 30) {
        height = 30
    }

    var snake = listOf(Point(width / 2, height / 2))
    var dirX = 1
    var dirY = 0
    var foods = listOf(getRandomPoint(width, height))
    var ticksUntilNextFood = FOOD_SPAWN_MIN_TICKS + randomInt(FOOD_SPAWN_MAX_TICKS - FOOD_SPAWN_MIN_TICKS + 1)
    var alive = true

    enableRawMode()
    hideCursor()
    clearScreen()

    while (alive) {
        val key = readByte()
        if (key != null) {
            var k = key
            if (k == KEY_ESCAPE) {
                val b2 = readByte()
                if (b2 != null && b2 == ARROW_PREFIX) {
                    val b3 = readByte()
                    if (b3 == ARROW_UP_BYTE) {
                        k = KEY_UP
                    } else if (b3 == ARROW_DOWN_BYTE) {
                        k = KEY_DOWN
                    } else if (b3 == ARROW_LEFT_BYTE) {
                        k = KEY_LEFT
                    } else if (b3 == ARROW_RIGHT_BYTE) {
                        k = KEY_RIGHT
                    }
                }
            }
            if (k == KEY_QUIT) {
                alive = false
            } else if (k == KEY_LEFT && dirX != 1) {
                dirX = -1
                dirY = 0
            } else if (k == KEY_RIGHT && dirX != -1) {
                dirX = 1
                dirY = 0
            } else if (k == KEY_UP && dirY != 1) {
                dirX = 0
                dirY = -1
            } else if (k == KEY_DOWN && dirY != -1) {
                dirX = 0
                dirY = 1
            }
        }

        if (alive) {
            val head: Point = snake.get(snake.size() - 1)
            val newHead = Point(head.x + dirX, head.y + dirY)

            if (newHead.x < 0 || newHead.x >= width || newHead.y < 0 || newHead.y >= height) {
                alive = false
            } else {
                var hitSelf = false
                for (seg in snake) {
                    if (seg.x == newHead.x && seg.y == newHead.y) {
                        hitSelf = true
                    }
                }

                if (hitSelf) {
                    alive = false
                } else {
                    snake.add(newHead)
                    var eatenIndex = -1
                    var fi = 0
                    for (f in foods) {
                        if (f.x == newHead.x && f.y == newHead.y) {
                            eatenIndex = fi
                        }
                        fi = fi + 1
                    }
                    if (eatenIndex >= 0) {
                        foods.removeAt(eatenIndex)
                    } else {
                        snake.removeAt(0)
                    }

                    // A new apple appears every FOOD_SPAWN_MIN_TICKS..
                    // FOOD_SPAWN_MAX_TICKS ticks, up to MAX_FOOD at once.
                    ticksUntilNextFood = ticksUntilNextFood - 1
                    if (ticksUntilNextFood <= 0 && foods.size() < MAX_FOOD) {
                        var placed = false
                        var attempts = 0
                        while (!placed && attempts < FOOD_PLACEMENT_ATTEMPTS) {
                            val candidate = getRandomPoint(width, height)
                            var free = true
                            for (s in snake) {
                                if (s.x == candidate.x && s.y == candidate.y) {
                                    free = false
                                }
                            }
                            for (f2 in foods) {
                                if (f2.x == candidate.x && f2.y == candidate.y) {
                                    free = false
                                }
                            }
                            if (free) {
                                foods.add(candidate)
                                placed = true
                            }
                            attempts = attempts + 1
                        }
                        ticksUntilNextFood = FOOD_SPAWN_MIN_TICKS + randomInt(FOOD_SPAWN_MAX_TICKS - FOOD_SPAWN_MIN_TICKS + 1)
                    }

                    moveCursor(1, 1)

                    // Fence around the perimeter — purely visual, drawn
                    // outside the width x height play area used for
                    // collision detection above, which is unchanged by
                    // this. One color switch for the whole line (it's
                    // uniform), not one per character.
                    var fenceLine = style(COLOR_WHITE) + FENCE_CHAR
                    for (fcol in 1..width + 1) {
                        fenceLine += FENCE_CHAR
                    }
                    fenceLine += resetColor()
                    println(fenceLine)

                    for (row in 0..height - 1) {
                        var line = style(COLOR_WHITE) + FENCE_CHAR
                        var currentKind = KIND_NONE
                        for (col in 0..width - 1) {
                            var ch = GRASS_CHAR
                            var kind = KIND_GRASS
                            for (f3 in foods) {
                                if (f3.x == col && f3.y == row) {
                                    ch = FOOD_CHAR
                                    kind = KIND_FOOD
                                }
                            }
                            for (s in snake) {
                                if (s.x == col && s.y == row) {
                                    ch = SNAKE_CHAR
                                    kind = KIND_SNAKE
                                }
                            }
                            if (kind != currentKind) {
                                if (kind == KIND_GRASS) {
                                    line += style(COLOR_GREEN)
                                } else if (kind == KIND_SNAKE) {
                                    line += style(COLOR_BRIGHT_YELLOW)
                                } else if (kind == KIND_FOOD) {
                                    line += styleBold(COLOR_BRIGHT_RED)
                                }
                                currentKind = kind
                            }
                            line += ch
                        }
                        line += style(COLOR_WHITE) + FENCE_CHAR + resetColor()
                        println(line)
                    }
                    println(fenceLine)
                    println("score: ${snake.size() - 1}   (wasd/arrows to steer, q to quit)")
                }
            }
        }

        sleep(120)
    }

    disableRawMode()
    showCursor()
    clearScreen()
    moveCursor(1, 1)
    println("Game over! Score: " + (snake.size() - 1))
}

main()
