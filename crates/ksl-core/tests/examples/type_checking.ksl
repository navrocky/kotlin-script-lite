// Static + runtime type system: correctly-typed val/var/fun end-to-end,
// plus proof Int/Double arithmetic widening is unaffected.
val name: String = "world"
var count: Int = 0

fun greet(who: String, times: Int): String {
    var result = ""
    var i = 0
    while (i < times) {
        result = result + "Hello, " + who + "! "
        i = i + 1
    }
    return result
}

println(greet(name, 3))

count = count + 1
println(count)

// Int/Double still mix freely in arithmetic (widening, not an assignment
// rule) -- unaffected by the new type checks.
val mixed = 1 + 2.5
println(mixed)

// A `var` with no explicit hint still infers its type from the
// initializer (here, Int) and is enforced on reassignment exactly like an
// explicitly annotated one -- reassigning it to another Int is fine.
var inferred = 5
inferred = inferred + 1
println(inferred)
