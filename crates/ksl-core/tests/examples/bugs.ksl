fun run(block: () -> Unit) { block() }

run {
    // Bug 1 (fixed): не работает инициализация поля в секции init
    class TestClass1 {
        val field: String // тут ломается не видит инициализацию поля в init{}
        init {
            field = ""
        }
    }
}

run {
    // Bug 2: Вызов функции до её объявления
    fun useTest() {
        test() // Сейчас LSP не видит функцию (hint, переход)
    }

    fun test() {}
}

