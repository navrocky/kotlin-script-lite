run {
    // Bug 6: Test2 не видит класс Test
    class Test {
    }

    class Test2(val t: Test) { // Здесь LSP не видит тип поля Test
        fun get(test: Test): Test = Test() // Здесь LSP не видит тип параметра и тип возврата Test
    }
}
