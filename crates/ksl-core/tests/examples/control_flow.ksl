// if/when as expressions, while, do/while, for over a range and a list, break/continue.
fun classify(n: Int): String {
    return when {
        n < 0 -> "negative"
        n == 0 -> "zero"
        n % 2 == 0 -> "even"
        else -> "odd"
    }
}

for (n in -1..4) {
    println("$n is ${classify(n)}")
}

var i = 0
var sum = 0
while (i < 10) {
    i = i + 1
    if (i % 2 == 0) {
        continue
    }
    if (i > 7) {
        break
    }
    sum = sum + i
}
println("sum = $sum")

val label = if (sum > 10) "big" else "small"
println("label = $label")

for (word in listOf("a", "bb", "ccc")) {
    println("${word}: ${length(word)}")
}

// do/while: body runs at least once, condition checked after it.
var count = 0
do {
    count = count + 1
} while (count < 3)
println("count = $count")
